<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xnch.vibe-dj</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/xnch/xnchSystems/xnch/agents/vibe-dj/vibe-dj.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/xnch/xnchSystems/xnch/agents/vibe-dj</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/xnch/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/xnch</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/vibe-dj.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/vibe-dj.err.log</string>
</dict>
</plist>
